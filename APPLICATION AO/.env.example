# ==========================================================
#  D’Aplomb - configuration
#  installer.ps1 cree automatiquement le fichier .env a partir
#  de ce modele (secrets aleatoires). Ne partagez jamais .env.
# ==========================================================

# Adresse dans le navigateur : http://localhost:8080
APP_PORT=8080

# Securite (generee automatiquement par installer.ps1)
DJANGO_SECRET_KEY=__A_GENERER__
DJANGO_DEBUG=0

# Noms et adresses autorises a ouvrir l'application.
# Ajoutez l'adresse IP du PC ou le nom de domaine pour un acces depuis un autre poste,
# par exemple : localhost,127.0.0.1,192.168.1.20
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Mettre a 1 uniquement lorsque l'application est servie en HTTPS
COOKIES_HTTPS=0

# Base de donnees
POSTGRES_DB=application_ao
POSTGRES_USER=application_ao
POSTGRES_PASSWORD=__A_GENERER__

# Taille maximale d'un fichier importe (en Mo)
TAILLE_MAX_FICHIER_MO=200

# Assistant IA local (administrateur) - modeles gratuits telecharges une fois par installer.ps1
# Modele de conversation : qwen3.5:9b (recommande quand Docker dispose d'au moins 14 Go,
# soit un PC de 32 Go) ou qwen3.5:4b (plus rapide, pour un PC de 16 Go).
# installer.ps1 choisit automatiquement selon la memoire allouee a Docker.
IA_MODELE=qwen3.5:9b
IA_MODELE_EMBEDDING=bge-m3
# Transcription de la voix : large-v3-turbo (precis) ou small (plus leger)
IA_WHISPER=large-v3-turbo
IA_VOIX=fr_FR-siwis-medium

# Messagerie du cabinet (facultatif) pour envoyer le DCE depuis l'application.
# Sans ces reglages, l'application prepare les messages et vous les envoyez vous-meme.
# Exemple Microsoft 365 : EMAIL_HOST=smtp.office365.com, EMAIL_PORT=587, EMAIL_USE_TLS=1
# Exemple Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587 (mot de passe d'application)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Taille maximale du dossier joint a un courriel (en Mo) ; au-dela, lien de transfert a envoyer soi-meme
EMAIL_PIECE_JOINTE_MAX_MO=20

# ----------------------------------------------------------
#  GED de chantier
# ----------------------------------------------------------
# Adresse de l'application sur le reseau du cabinet, utilisee dans les courriels de la GED
# (par exemple http://192.168.1.20:8080). Vide : http://localhost:8080
URL_APPLICATION=

# Archives de fin de chantier : dossier du PC ou d'un disque (par exemple D:\Archives chantiers).
# Vide : dossier « donnees\archives » de l'application.
DOSSIER_ARCHIVES_PC=

# GED ouverte aux entreprises sur Internet (facultatif, installer.ps1 pose les questions).
# Mode : aucun (reseau du cabinet seulement), ip (adresse fixe de la box) ou tunnel (Cloudflare).
# Vide : installer.ps1 pose la question (videz la ligne pour rouvrir la GED apres un refus).
GED_INTERNET=
# Adresse racine de la GED, sans chemin ni / final (par exemple https://ged.cabinet.fr) ;
# les entreprises ouvrent cette adresse suivie de /ged :
GED_URL_PUBLIQUE=
# Port de CE PC vers lequel la box redirige son port 443 (mode adresse publique) : 443 recommande.
GED_PORT_HTTPS=443
# Mode Cloudflare Tunnel uniquement : jeton du tunnel (Cloudflare Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# ----------------------------------------------------------
#  Stockage sur le serveur de l'agence (recommande)
# ----------------------------------------------------------
# installer.ps1 pose la question, verifie l'acces au dossier partage (depuis Windows et depuis
# Docker) et remplit ces lignes. Les fichiers de l'application, les archives de fin de chantier et
# les sauvegardes de chaque nuit vont alors dans les sous-dossiers fichiers, archives et sauvegardes
# du partage. La base de donnees reste sur ce PC ; sa copie de chaque nuit part sur le serveur.
# STOCKAGE : serveur, pc, ou vide (question posee au prochain lancement de installer.ps1).
# Pour changer : videz la ligne STOCKAGE= puis relancez installer.ps1 (les fichiers sont recopies).
STOCKAGE=
# Dossier partage tel qu'il apparait dans Windows, par exemple \\SERVEUR\DAplomb
SERVEUR_CHEMIN_AFFICHE=
# Adresse IP du serveur (trouvee par installer.ps1 : Docker ne connait pas les noms du reseau Windows)
SERVEUR_ADRESSE=
# Nom du partage, suivi d'un sous-dossier eventuel separe par / (par exemple DAplomb ou Donnees/DAplomb)
SERVEUR_PARTAGE=
# Compte Windows dedie a D’Aplomb (droit de modification sur ce seul dossier), son mot de passe et
# son domaine (facultatif). Le mot de passe est enregistre ici comme les autres cles : ne partagez
# jamais ce fichier. Pas de virgule, de guillemet ni d'apostrophe dans ce mot de passe. Une valeur
# qui contient des espaces, des \, $ ou # s'ecrit entre apostrophes droites : SERVEUR_MOT_DE_PASSE='...'
SERVEUR_UTILISATEUR=
SERVEUR_MOT_DE_PASSE=
SERVEUR_DOMAINE=
# Remplis par installer.ps1 en mode serveur (ne pas modifier) : volumes du partage pour tous les
# services, y compris celui de la GED ouverte sur Internet.
VOLUME_FICHIERS=
VOLUME_ARCHIVES=

# ----------------------------------------------------------
#  Sauvegarde automatique chaque nuit
# ----------------------------------------------------------
# Copie de la base de donnees (verifiee par une restauration d'essai), copie de ce fichier .env
# (sa cle DJANGO_SECRET_KEY garde valides les codes d'acces de la GED apres une restauration) et,
# si les fichiers sont sur ce PC, copie des fichiers et des archives. Le PC doit etre allume, la
# session Windows ouverte (Docker Desktop) ; sinon la sauvegarde est faite au demarrage suivant.
# En cas d'echec, courriel aux administrateurs si la messagerie est reglee (lignes EMAIL_...).
# Heure de la sauvegarde (heure de Paris) :
SAUVEGARDE_HEURE=2:30
# Sauvegardes gardees : la derniere de chacun des SAUVEGARDE_JOURS derniers jours qui ont une
# sauvegarde, plus la premiere de chacun des SAUVEGARDE_MOIS derniers mois.
SAUVEGARDE_JOURS=14
SAUVEGARDE_MOIS=6
# Fichiers sur ce PC uniquement : dossier des sauvegardes, idealement un autre disque que celui de
# l'application et de Docker (disque externe toujours branche, par exemple E:\Sauvegardes DAplomb).
# Vide : dossier donnees\sauvegardes de l'application, sur le meme disque (deconseille).
# Pas de dossier reseau (\\NAS\...) : Docker ne sait pas l'ouvrir ; videz plutot la ligne STOCKAGE= pour choisir le serveur de l'agence.
DOSSIER_SAUVEGARDES_PC=
