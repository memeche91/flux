# Serveur web de l'application : interface React + relais vers Django.
:80 {
	# Les réponses de l'assistant arrivent mot à mot : elles ne sont pas compressées.
	@compressible not path /api/assistant/*
	encode @compressible zstd gzip

	request_body {
		max_size 1GB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@django path /api /api/* /admin /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
